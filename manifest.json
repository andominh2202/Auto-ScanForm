{
  "manifest_version": 3,
  "name": "FormMaster AI - Điền Mọi Loại Form",
  "version": "1.1.0",
  "description": "Tự động phát hiện và điền thông tin chính xác trên Google Forms, Typeform, Web tuyển dụng (TopCV, LinkedIn), Đăng ký dịch vụ, Mua hàng...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FormMaster AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://forms.gle/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "data/default-profiles.js",
        "content/rules.js",
        "content/detector.js",
        "content/form-filler.js",
        "content/floating-widget.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/floating-widget.css",
        "icons/*.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "autofill_active_page": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Tự động điền trang web đang mở"
    }
  }
}
